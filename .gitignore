# Secrets
.env

# Tijdelijke push-mappen.
# Deze bevatten een git-kloon met het GITHUB_TOKEN in .git/config. Ze worden
# normaal opgeruimd, maar bij een onderbroken build blijven ze staan — en dan
# zou de sync-skill ze mee committen. Alle drie moeten hier staan.
.registry-push-tmp/
.badges-push-tmp/
.site-push-tmp/

# Build output (niet in de bronrepo — wordt apart gepubliceerd)
output/
ghl/
badges/

# OS / editor
.DS_Store
Thumbs.db
desktop.ini
*.swp
.idea/
.vscode/

# Node
node_modules/

# Claude Code — lokale, persoonlijke instellingen (permissies e.d.)
.claude/settings.local.json

# Draaiend logboek van de watchdog (machine-lokaal, groeit continu)
reports/watchdog-taken.log

# Handmatig gedownloade Apify-exports (bestandsnaam bevat "dataset_").
#
# Alleen scripts/normalize.js leest deze, één keer per regio, om er
# data/<slug>/reviews.json van te maken. Daarna kijkt niets ze ooit nog in:
# build.js leest uitsluitend reviews.json en beoordeling.json. Ze zijn wel
# groot — 54 MB voor drie regio's — en git gooit nooit iets weg, dus elk
# exemplaar dat hier binnenglipt blijft voor altijd in de geschiedenis staan.
#
# LET OP — dit geldt NIET voor de bestanden die de n8n-scraper aanlevert
# (data/<slug>/<slug>-<datum>-reviews.json en -places.json). Die komen juist
# VIA deze repo binnen: git is daar het transportkanaal van de scraper naar de
# laptop. Die mag je niet negeren of untracken, anders breekt het proces van
# een nieuwe regio. Zie de regel "Ruwe scrapedata" in CLAUDE.md.
data/*/*dataset_*.json

# Outreach-logboek: bevat mailadressen van bedrijven. De repos zijn publiek
# leesbaar (gecontroleerd 2026-09-04), dus dit bestand blijft lokaal.
# Aanleggen/bijwerken: node scripts/outreach-seed.js
data/outreach.json
data/outreach.json.tmp
reports/outreach-dashboard.html

# De ruwe Gmail-feiten waarmee het logboek gevuld is (mailadressen, thread-ID's).
# Zelfde reden. Zie scripts/outreach-gmail.md voor de vorm.
data/outreach-gmail.json

# De knoppenpagina van scripts/whatsapp-nabericht.js: bedrijfsnamen en
# telefoonnummers, dus niet naar een publieke repo.
reports/whatsapp-berichten.html
reports/whatsapp-nabericht.log
